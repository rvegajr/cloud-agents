{
  "$comment": "The fleet registry: one list of what is deployed where, read by `npm run version-board`. Add a service here, not in a second list. `expect.branch` is the ref a healthy deploy should be sitting on; `graceSeconds` is how long a fresh merge may take to roll out before it counts as stale.",
  "defaults": {
    "graceSeconds": 900
  },
  "services": [
    {
      "name": "tailorfolio",
      "env": "production",
      "health": "https://tailorfolio.com/health",
      "repo": "rvegajr/tailorfolio",
      "expect": { "branch": "main" }
    },
    {
      "name": "tailorfolio",
      "env": "uat",
      "health": "https://uat.tailorfolio.com/health",
      "repo": "rvegajr/tailorfolio",
      "expect": { "branch": "uat" }
    },
    {
      "name": "tailorfolio",
      "env": "dev",
      "health": "https://dev.tailorfolio.com/health",
      "repo": "rvegajr/tailorfolio",
      "expect": { "branch": "develop" }
    },
    {
      "name": "blessbox",
      "env": "production",
      "health": "https://www.blessbox.org/api/health",
      "repo": "rvegajr/blessbox",
      "expect": { "branch": "main" },
      "note": "commit lands with blessbox#230; if commitSource comes back unknown, set BUILD_COMMIT_SHA as a runtime env in Vercel"
    },
    {
      "name": "noctusoft-relay",
      "env": "production",
      "health": "https://api.sendgrid.noctusoft.com/health",
      "repo": "rvegajr/noctusoft-relay",
      "expect": { "branch": "main" },
      "note": "commit lands with noctusoft-relay#78 on the next deploy.sh run; it reads HEAD from the checkout, nothing to stamp"
    },
    {
      "name": "emberlead-web",
      "env": "production",
      "health": "https://www.tankroom.pro/health",
      "repo": "YOLOVibeCode/emberlead",
      "expect": { "branch": "main" },
      "note": "Railway waits for CI before deploying web; a cancelled or failed CI run leaves web behind api and workers"
    },
    {
      "name": "emberlead-api",
      "env": "production",
      "health": "https://api.emberlead.pro/health",
      "repo": "YOLOVibeCode/emberlead",
      "expect": { "branch": "main" }
    },
    {
      "name": "emberlead-workers",
      "env": "production",
      "health": "https://workers.emberlead.pro/health",
      "repo": "YOLOVibeCode/emberlead",
      "expect": { "branch": "main" }
    },
    {
      "name": "emberlead-web",
      "env": "uat",
      "health": "https://uat.emberlead.pro/health",
      "repo": "YOLOVibeCode/emberlead",
      "expect": { "branch": "develop" }
    },
    {
      "name": "emberlead-api",
      "env": "uat",
      "health": "https://uat-api.emberlead.pro/health",
      "repo": "YOLOVibeCode/emberlead",
      "expect": { "branch": "develop" }
    },
    {
      "name": "emberlead-workers",
      "env": "uat",
      "health": "https://workers-uat.up.railway.app/health",
      "repo": "YOLOVibeCode/emberlead",
      "expect": { "branch": "develop" }
    },
    {
      "name": "emberlead-web",
      "env": "dev",
      "health": "https://dev.emberlead.pro/health",
      "repo": "YOLOVibeCode/emberlead",
      "expect": { "branch": "develop" }
    },
    {
      "name": "emberlead-api",
      "env": "dev",
      "health": "https://dev-api.emberlead.pro/health",
      "repo": "YOLOVibeCode/emberlead",
      "expect": { "branch": "develop" }
    },
    {
      "name": "emberlead-workers",
      "env": "dev",
      "health": "https://workers-dev-351d.up.railway.app/health",
      "repo": "YOLOVibeCode/emberlead",
      "expect": { "branch": "develop" }
    },
    {
      "name": "flight-deck",
      "env": "production",
      "health": "https://myflightdeck.app/api/health",
      "repo": "rvegajr/sji-flight-deck-platform",
      "expect": { "branch": "main" }
    },
    {
      "name": "flight-deck",
      "env": "uat",
      "health": "https://uat.myflightdeck.app/api/health",
      "repo": "rvegajr/sji-flight-deck-platform",
      "expect": { "branch": "uat" }
    },
    {
      "name": "flight-deck",
      "env": "develop",
      "health": "https://develop.myflightdeck.app/api/health",
      "repo": "rvegajr/sji-flight-deck-platform",
      "expect": { "branch": "develop" }
    },
    {
      "name": "scholarmancy-api",
      "env": "production",
      "health": "https://api.scholarmancy.com/api/health",
      "repo": "YOLOVibeCode/scholaracle",
      "expect": { "branch": "main" }
    },
    {
      "name": "scholarmancy-web",
      "env": "production",
      "health": "https://scholarmancy.com/api/health",
      "repo": "YOLOVibeCode/scholaracle",
      "expect": { "branch": "main" }
    },
    {
      "name": "cloud-agents-slack",
      "env": "production",
      "health": "https://slack-production-5120.up.railway.app/health",
      "repo": "rvegajr/cloud-agents",
      "expect": { "branch": "main" },
      "note": "deployed with railway up, not on merge; behind means a merge has not been shipped to the bot"
    },
    {
      "name": "cloud-agents-slack-whm",
      "env": "production",
      "health": "https://slack-whm-production.up.railway.app/health",
      "repo": "rvegajr/cloud-agents",
      "expect": { "branch": "main" },
      "note": "deployed with railway up, not on merge; behind means a merge has not been shipped to the bot"
    }
  ]
}
