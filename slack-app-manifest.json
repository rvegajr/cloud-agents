{
  "display_information": {
    "name": "CloudAgents",
    "description": "Turns a Slack @mention into a cloud-agent pull request. Rename freely; the bot reads its own name at startup.",
    "background_color": "#1a1a1a"
  },
  "features": {
    "bot_user": {
      "display_name": "CloudAgents",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "channels:history",
        "groups:history",
        "channels:read",
        "groups:read",
        "channels:join",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
