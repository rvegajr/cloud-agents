# Copy to .env, fill in, then run `npm run doctor`. It proves every token, scope,
# and grant below without posting to Slack or changing anything, and names the fix
# for whatever is missing. IMPLEMENTATION-GUIDE.md is the phase-by-phase recipe.

# Option A: paste a key from https://cursor.com/dashboard/integrations
# Option B: leave blank and run `npm run login` (browser login, key stored in ~/.cursor/sdk/auth.json)
CURSOR_API_KEY=

# Model used by every script unless overridden. `composer-2.5` is the current default.
# Run `npm run status` to list the models your account can use.
CURSOR_MODEL=composer-2.5

# GitHub repo the cloud scripts and the Slack bot operate on. Must be connected
# to Cursor (cursor.com/agents -> connect GitHub). `npm run status` lists them.
# TARGET_REF is the integration branch the agent branches from: main, develop, etc.
TARGET_REPO=https://github.com/your-org/your-repo
TARGET_REF=main
# Optional, and only read by `npm run doctor`: a local clone of TARGET_REPO, so the
# doctor can confirm the target-repo-kit files (AGENTS.md, .cursor/hooks.json) landed.
TARGET_REPO_PATH=

# Slack bot (npm run slack). Create an app from slack-app-manifest.json at
# api.slack.com/apps, enable Socket Mode, mint a bot token (xoxb-) and an
# app-level token with connections:write (xapp-).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated channel IDs (C…). Empty = allow every channel the bot is in.
SLACK_ALLOWED_CHANNELS=
# One bot, many repos: route a channel to its own repo (and branch). Keys are
# channel IDs (C…) or names (#name; needs the channels:read scope from the
# manifest). Mapped channels are implicitly allowed; unmapped ones fall back to
# TARGET_REPO/TARGET_REF.
#   SLACK_CHANNEL_REPOS=C0123ABCD=https://github.com/you/api@develop,#web-bugs=https://github.com/you/web
SLACK_CHANNEL_REPOS=
# Named projects for the mention CLI (`@<bot>`, `@<bot> <project>`, `@<bot> <project> -`),
# where @<bot> is whatever your workspace named the app you created from
# slack-app-manifest.json. A channel whose name starts with a project (#api-bugs,
# #api-anything) selects that project so the name can be omitted. Last duplicate wins.
#   SLACK_PROJECTS=api=https://github.com/you/api@develop,web=https://github.com/you/web@develop
SLACK_PROJECTS=
# The bot reads its own display name from Slack at startup and prints that in
# usage. Set this only to override (e.g. the app lacks users:read).
SLACK_BOT_HANDLE=
# Optional. Member id of Cursor's *official* Slack app (a different app from this
# bot). When set, someone who mentions @Cursor in a channel this bot is in gets a
# short pointer to @<bot> plus the usage. Leave empty to disable.
SLACK_CURSOR_USER_ID=
# Optional. Cloud Agents always open PRs as drafts, and most auto-merge setups
# ignore drafts. With a token that can write pull requests on the target repos,
# the bot marks a PR "ready for review" once the verifier reports done. A failed
# verify leaves it a draft.
#
# MUST be a classic PAT with `repo` scope (or another user-level OAuth token).
# GitHub's markPullRequestReadyForReview mutation rejects every fine-grained PAT
# and every GitHub App / Actions installation token with "Resource not
# accessible by personal access token", no matter which permissions are granted,
# and there is no REST equivalent. Give it a short expiry and store it only in
# the bot's deploy env; the bot uses it for this one mutation.
GITHUB_TOKEN=
# Max cloud-agent jobs the process will run at once.
SLACK_MAX_CONCURRENT=2
# Link printed under every usage message ("Full instructions: …"). Defaults to
# the kit's Slack walkthrough on GitHub; point it at your own doc if you fork.
SLACK_DOCS_URL=

# Deploys: there is nothing to configure here, on purpose.
#
# The bot cannot deploy and holds no deploy credentials. Merging a PR is the only
# trigger: the host builds from the branch and posts the result to the channel
# itself (Vercel for Slack, or a Railway webhook — IMPLEMENTATION-GUIDE.md
# phase F). If you are migrating from 0.1.x, delete SLACK_DEPLOYS,
# SLACK_DEPLOYERS, VERCEL_TOKEN, VERCEL_TEAM_ID, RAILWAY_TOKEN and
# RAILWAY_API_TOKEN from your .env and from the host; `npm run doctor` warns
# while any of them are still set.

# Set automatically by `npm run deploy`, which stamps the commit so the running
# bot can report it at startup and on `@<bot> version`. Never set it by hand.
BUILD_INFO=

# Optional. Lets the Slack bot fetch jam.dev recordings (console, network,
# video analysis) and paste them into the cloud-agent prompt. Create a PAT at
# jam.dev → Settings → MCP with mcp:read (and mcp:write if you want comments).
# The `jam` CLI also honours this as JAM_TOKEN.
JAM_TOKEN=
