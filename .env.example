# Copy to .env, fill in, then run `npm run doctor`. It proves every token, scope,
# and grant below without posting to Slack or changing anything, and names the fix
# for whatever is missing. IMPLEMENTATION-GUIDE.md is the phase-by-phase recipe.

# Option A: paste a key from https://cursor.com/dashboard/integrations
# Option B: leave blank and run `npm run login` (browser login, key stored in ~/.cursor/sdk/auth.json)
CURSOR_API_KEY=

# Model used by every script unless overridden. `composer-2.5` is the current default.
# The kit always passes Fast=false; Cursor's product default is Fast and ~6× the price.
# Run `npm run status` to list the models your account can use.
CURSOR_MODEL=composer-2.5

# CLI default engine: cursor | claude | hybrid | local.
#   claude  every phase on Claude Max (Agent SDK, this box holds the clone)
#   hybrid  Max writes the plan; LOCAL_MODEL implements and verifies on Ollama;
#           Max re-runs a failed verify once (HYBRID_RESCUE). Cheapest way to
#           stay under the Max weekly cap while still shipping.
#   local   Ollama only; never touches Max.
# Slack is independent of this: only the Slack user ids in SLACK_CLAUDE_USER_IDS
# run on the Max-backed engine named here (claude when ENGINE=cursor); everyone
# else stays on Cursor. Empty allowlist = Claude off for Slack.
ENGINE=cursor
CLAUDE_MODEL=sonnet
# From `claude setup-token` on this box. Do not also set ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=
# Local executor for ENGINE=hybrid|local (needs `ollama serve` and the qwen-code
# CLI, or aider, on PATH). `npm run doctor` proves each one.
#   OLLAMA_HOST            Ollama base URL; default http://localhost:11434
#   LOCAL_MODEL            executor tag from `ollama list`; measured best: qwen3-coder-next
#                          (80B-A3B, 52 GB) or qwen3.6:35b-coding (23 GB); qwen3-coder:30b is fastest
#   LOCAL_PLANNER_MODEL    model for plans diverted off Max (over the ceiling, or ENGINE=local);
#                          default LOCAL_MODEL. gpt-oss:120b is the strongest local planner.
#   LOCAL_RUNNER           qwen (agentic, runs the verification commands) | aider (3-5x faster edits)
#   LOCAL_TURN_TIMEOUT_MIN default 30
OLLAMA_HOST=
LOCAL_MODEL=
LOCAL_PLANNER_MODEL=
LOCAL_RUNNER=
# Hybrid routing. Every Claude turn first checks the Max utilization the Agent
# SDK reported last (.runs/max-usage.json). At or above the ceiling the turn is
# diverted to LOCAL_PLANNER_MODEL (HYBRID_OVER_CEILING=local) or the job stops
# (=stop); it never buys extra usage. Per-phase overrides take claude|local.
MAX_UTILIZATION_CEILING=0.85
HYBRID_OVER_CEILING=local
HYBRID_PLAN=claude
HYBRID_IMPLEMENT=local
HYBRID_VERIFY=local
HYBRID_QA=local
HYBRID_REVIEW=claude
HYBRID_RESCUE=1
# Deterministic quality gate the orchestrator runs (no model) after every local
# iterate/finish/unblock turn: the repo's own lint/typecheck/test/build, a
# clean-clone start, hygiene (no .qwen/, dist/, *.db, .env tracked), and
# config/test tamper detection. A failing gate is fed back as a continuation up
# to LOCAL_GATE_RETRIES times before the turn counts as failed. See
# architect-crew-gate/PATTERN.md section 4.
# Which loop `npm run build-app` runs: milestone (default) or blueprint
# (architect-crew-gate/PATTERN.md: requirements → blueprint → gated tasks →
# QA on a fresh clone → independent review). Blueprint needs an engine that owns
# its clone (hybrid | local | claude). `--loop` on the CLI overrides.
BUILD_LOOP=milestone
LOCAL_GATE=1
LOCAL_GATE_RETRIES=2
LOCAL_GATE_START_SEC=30
LOCAL_GATE_CMD_MIN=10
LOCAL_GATE_VACUOUS=finish
LOCAL_GATE_START_EVERY=3
# The QA analyst's browser (blueprint loop, stage 4): playwright (default) runs
# a headless, isolated Chromium through @playwright/mcp for the QA turn only
# (qwen-code --mcp-config, or mcpServers on the Claude SDK); 0 = no browser.
# PLAYWRIGHT_MCP_ARGS replaces the default flags. Scenarios that name a page,
# a click, or typing are executed there; the snapshot is the evidence.
QA_BROWSER=playwright
PLAYWRIGHT_MCP_ARGS=--headless --isolated
# Where ENGINE=claude clones. Default: $TMPDIR/cloud-agents-work
WORK_ROOT=

# Parallel Cursor factory (`npm run build-farm`). Always ENGINE=cursor.
# Cap is dollars of charged (or list) usage across the wave; in-flight jobs finish.
FARM_MAX_USD=10
FARM_CONCURRENCY=5
# GitHub App slug used to grant newly created repos before Agent.create.
# Default `cursor`. Comma-separated if the install uses another slug.
CURSOR_GITHUB_APP_SLUG=cursor

# GitHub repo the cloud scripts and the Slack bot operate on. Must be connected
# to Cursor (cursor.com/agents -> connect GitHub). `npm run status` lists them.
# TARGET_REF is the integration branch the agent branches from: main, develop, etc.
TARGET_REPO=https://github.com/your-org/your-repo
TARGET_REF=main
# Optional, and only read by `npm run doctor`: a local clone of TARGET_REPO, so the
# doctor can confirm the target-repo-kit files (AGENTS.md, .cursor/hooks.json) landed.
TARGET_REPO_PATH=

# Slack bot (npm run slack). Create an app from slack-app-manifest.json at
# api.slack.com/apps, enable Socket Mode, mint a bot token (xoxb-) and an
# app-level token with connections:write (xapp-).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated channel IDs (C…). Empty = allow every channel the bot is in.
SLACK_ALLOWED_CHANNELS=
# One bot, many repos: route a channel to its own repo (and branch). Keys are
# channel IDs (C…) or names (#name; needs the channels:read scope from the
# manifest). Mapped channels are implicitly allowed; unmapped ones fall back to
# TARGET_REPO/TARGET_REF.
#   SLACK_CHANNEL_REPOS=C0123ABCD=https://github.com/you/api@develop,#web-bugs=https://github.com/you/web
SLACK_CHANNEL_REPOS=
# Named projects for the mention CLI (`@<bot>`, `@<bot> <project>`, `@<bot> <project> -`),
# where @<bot> is whatever your workspace named the app you created from
# slack-app-manifest.json. A channel whose name starts with a project (#api-bugs,
# #api-anything) selects that project so the name can be omitted. Last duplicate wins.
#   SLACK_PROJECTS=api=https://github.com/you/api@develop,web=https://github.com/you/web@develop
SLACK_PROJECTS=
# The bot reads its own display name from Slack at startup and prints that in
# usage. Set this only to override (e.g. the app lacks users:read).
SLACK_BOT_HANDLE=
# Optional. Member id of Cursor's *official* Slack app (a different app from this
# bot). When set, someone who mentions @Cursor in a channel this bot is in gets a
# short pointer to @<bot> plus the usage. Leave empty to disable.
SLACK_CURSOR_USER_ID=
# Your Slack member id (U…). Mentions from these users run Claude Max on this
# box; everyone else stays on Cursor. Empty = Claude off for Slack.
SLACK_CLAUDE_USER_IDS=
# Optional. Cloud Agents always open PRs as drafts, and most auto-merge setups
# ignore drafts. With a token that can write pull requests on the target repos,
# the bot marks a PR "ready for review" once the verifier reports done. A failed
# verify leaves it a draft.
#
# MUST be a classic PAT with `repo` scope (or another user-level OAuth token).
# GitHub's markPullRequestReadyForReview mutation rejects every fine-grained PAT
# and every GitHub App / Actions installation token with "Resource not
# accessible by personal access token", no matter which permissions are granted,
# and there is no REST equivalent. Give it a short expiry and store it only in
# the bot's deploy env; the bot uses it for this one mutation.
GITHUB_TOKEN=
# HTTP control plane on the same process as `npm run slack`.
# POST /v1/jobs runs the mention CLI directly and posts progress to Slack.
# POST /v1/mentions posts `<@CloudAgents> …` as the Dispatcher app (below).
# GET /health is open; everything else needs this bearer token.
JOBS_API_TOKEN=
# Local default is 8787 when JOBS_API_TOKEN is set. On Railway, PORT is used.
JOBS_API_PORT=
# Second Slack app from slack-dispatcher-manifest.json. Its B… id must be listed
# so CloudAgents accepts the mention (it ignores its own bot_id). Slack skips
# app_mention for bot posts; the message event is what wakes CloudAgents.
# The xoxb- token is only needed for POST /v1/mentions.
SLACK_DRIVER_BOT_IDS=
SLACK_DRIVER_TOKEN=

# Max cloud-agent jobs the process will run at once.
SLACK_MAX_CONCURRENT=2
# Link printed under every usage message ("Full instructions: …"). Defaults to
# the kit's Slack walkthrough on GitHub; point it at your own doc if you fork.
SLACK_DOCS_URL=

# Deploys: there is nothing to configure here, on purpose.
#
# The bot cannot deploy and holds no deploy credentials. Merging a PR is the only
# trigger: the host builds from the branch and posts the result to the channel
# itself (Vercel for Slack, or a Railway webhook — IMPLEMENTATION-GUIDE.md
# phase F). If you are migrating from 0.1.x, delete SLACK_DEPLOYS,
# SLACK_DEPLOYERS, VERCEL_TOKEN, VERCEL_TEAM_ID, RAILWAY_TOKEN and
# RAILWAY_API_TOKEN from your .env and from the host; `npm run doctor` warns
# while any of them are still set.

# Set automatically by `npm run deploy`, which stamps the commit so the running
# bot can report it at startup and on `@<bot> version`. Never set it by hand.
BUILD_INFO=

# Optional. Lets the Slack bot fetch jam.dev recordings (console, network,
# video analysis) and paste them into the cloud-agent prompt. Create a PAT at
# jam.dev → Settings → MCP with mcp:read (and mcp:write if you want comments).
# The `jam` CLI also honours this as JAM_TOKEN.
JAM_TOKEN=
